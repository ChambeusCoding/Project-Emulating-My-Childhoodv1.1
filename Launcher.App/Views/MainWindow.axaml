<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="https://github.com/avaloniaui/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        x:Class="Launcher.App.Views.MainWindow"
        x:Name="MainWindowRoot"
        Width="1200"
        Height="800"
        Background="#121212"
        Title="RetroRunner beta 2.1"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        mc:Ignorable="d"
        Loaded="OnMainWindowLoaded">
    
    <Grid RowDefinitions="48,*,320">

<!-- ================= TOP BAR ================= -->
<Border Grid.Row="0"
        Background="#1E1E1E"
        CornerRadius="0,0,12,12"
        Padding="12,0">
    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="avares://Launcher.App/Assets/Shirtfffff.png"
                   Width="32" Height="32"/>
            <TextBlock Text="RetroRunner beta 2.1"
                       FontSize="16"
                       FontWeight="Bold"/>
        </StackPanel>
        
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Content="Scan Games"
                    CornerRadius="6"
                    Command="{Binding ScanGamesCommand}"/>
            <TextBox Width="200"
                     CornerRadius="6"
                     Watermark="Search…"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <ComboBox Width="160"
                      CornerRadius="6"
                      ItemsSource="{Binding EmulatorInstallers}"
                      SelectedItem="{Binding SelectedEmulatorInstaller}" />

            <Button Content="Install"
                    CornerRadius="6"
                    Command="{Binding InstallSelectedEmulatorCommand}" />
        </StackPanel>


    </Grid>
</Border>


        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            
            <Border Background="#181818"
                    CornerRadius="12"
                    Margin="12"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Systems"
                               FontWeight="Bold"
                               Margin="6,6,6,12"/>

                    <ItemsControl ItemsSource="{Binding Systems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,0,0,6"
                                        Background="#2A2A2A"
                                        Foreground="White"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.SelectSystemCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            
            <ScrollViewer Grid.Column="1">
                <ItemsControl ItemsSource="{Binding FilteredGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="16"
                                       ItemWidth="180"
                                       ItemHeight="260"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180"
                                    Height="260"
                                    Background="#252525"
                                    CornerRadius="12"
                                    Margin="0,0,16,16"
                                    Padding="8">
                                
                                <Grid RowDefinitions="160,*,Auto">

                                    <Border Grid.Row="0"
                                            Background="#333"
                                            CornerRadius="8"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Title}"
                                               Margin="4"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>

                                    <Button Grid.Row="2"
                                            Content="Play"
                                            Height="32"
                                            Margin="0,8,0,0"
                                            CornerRadius="8"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.LaunchGameCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <!-- ================= TERMINAL (INTERACTIVE) ================= -->
        <Border Grid.Row="2"
                Background="#0E0E0E"
                CornerRadius="12,12,0,0"
                Margin="12"
                BorderBrush="#2A2A2A"
                BorderThickness="1">

            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              Name="TerminalScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Name="TerminalOutputBox"
                             Text="{Binding TerminalOutput}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="monospace"
                             FontSize="12"
                             Background="#0E0E0E"
                             Foreground="#D0D0D0"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             Padding="6"/>
                </ScrollViewer>
                
                <Border Grid.Row="1"
                        Background="#161616"
                        CornerRadius="0,0,12,12"
                        Padding="8">
                    <TextBox Name="TerminalInputBox"
                             Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="terminal ›"
                             FontFamily="monospace"
                             FontSize="12"
                             Background="#161616"
                             Foreground="White"
                             BorderThickness="0"
                             KeyDown="OnTerminalKeyDown"/>
                </Border>
            </Grid>
        </Border>





    </Grid>
</Window>
